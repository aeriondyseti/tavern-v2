{
  "name": "tavern",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "tavern": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "drizzle",
    "README.md"
  ],
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist --external '@huggingface/transformers' --external 'onnxruntime-node' --external '@anthropic-ai/claude-agent-sdk' && bun ./scripts/copy-client.mjs",
    "typecheck": "tsc --noEmit",
    "drizzle:gen": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@huggingface/transformers": "^4.2.0",
    "@tavern/shared": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.3"
  }
}
