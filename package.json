{
  "name": "tales",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based tool for telling stories with an AI Narrator.",
  "license": "MIT",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "build": "bun --filter @tales/client build && bun --filter tales build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "arch": "dependency-cruiser apps packages",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "dependency-cruiser": "^17.3.10",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "lint-staged": "^16.4.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.1"
  }
}
